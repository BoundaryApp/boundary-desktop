{
  "name": "boundary-desktop",
  "productName": "Boundary",
  "version": "0.0.1-rc.13",
  "description": "Boundary",
  "main": ".vite/build/index.js",
  "type": "module",
  "scripts": {
    "dev": "DEBUG=boundary:* electron-forge start",
    "dev:product": "DEBUG=boundary:* electron-forge start",
    "dev:local-stack": "./scripts/dev-local-stack.sh",
    "dev:fresh": "./scripts/reset-boundary-dev-state.sh --yes && BOUNDARY_EMULATE_NO_DOCKER=1 DEBUG=boundary:* electron-forge start",
    "reset:dev-state": "./scripts/reset-boundary-dev-state.sh",
    "build": "electron-forge package",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "dist": "electron-forge make",
    "rebuild:macos-alias": "npm rebuild macos-alias",
    "dist:mac": "npm run fetch:container-runtime && npm run rebuild:macos-alias && electron-forge make --platform=darwin",
    "dist:win": "electron-forge make --platform=win32",
    "dist:linux": "electron-forge make --platform=linux",
    "publish": "electron-forge publish",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "check:unused": "knip",
    "check:duplicates": "node scripts/check-duplicates.mjs",
    "check:stack-archive": "node scripts/check-stack-archive.mjs",
    "check": "bun run type-check && bun run test && bun run lint && bun run check:unused && bun run check:duplicates && bun run check:stack-archive",
    "test": "vitest run",
    "test:main-services": "vitest run --config src/main/vitest.main-services.config.ts",
    "test:renderer-unit": "vitest run --config src/renderer/vitest.renderer-unit.config.ts",
    "fetch:container-runtime": "./scripts/fetch-container-runtime.sh",
    "notices": "node scripts/generate-third-party-notices.mjs",
    "smoke:bundled-podman": "./scripts/smoke-bundled-podman.sh",
    "test:inference": "vitest run --config src/main/vitest.main-services.config.ts",
    "test:hermes:live": "vitest run --config src/main/vitest.main-services.config.ts src/main/services/assistant/hermes/__tests__/hermesHistoryBudget.live.test.ts",
    "test:stack": "vitest run --config src/main/vitest.stack.config.ts",
    "test:circles": "vitest run --config src/main/vitest.circles.config.ts"
  },
  "keywords": [],
  "author": {
    "name": "Keith Axline",
    "email": "keith@yachtcopter.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/dockerode": "^4.0.2",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "electron": "45.0.0",
    "eslint": "^10.13.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.13.0",
    "hyperdht": "6.35.0",
    "jscpd": "5.4.2",
    "jsdom": "^30.1.3",
    "knip": "6.43.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.31",
    "@assistant-ui/store": "^0.3.22",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "autobase": "7.28.2",
    "better-sqlite3": "^13.0.3",
    "blind-pairing": "2.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compact-encoding": "3.5.2",
    "corestore": "^7.16.1",
    "debug": "^4.4.3",
    "dockerode": "^5.0.1",
    "drizzle-orm": "^0.45.4",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^12.0.0",
    "hyperbee": "2.27.3",
    "hypercore-crypto": "3.7.0",
    "hyperswarm": "^4.17.2",
    "js-yaml": "^5.5.0",
    "lucide-react": "^1.61.0",
    "protomux": "3.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "streamdown": "^2.7.1",
    "tailwind-merge": "^3.7.0",
    "ws": "^8.22.0",
    "z32": "1.1.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "node-abi": "^3.101.0"
  }
}
