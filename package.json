{
  "name": "boundary-desktop",
  "productName": "Boundary",
  "version": "0.0.1",
  "description": "Boundary",
  "main": ".vite/build/index.js",
  "type": "module",
  "scripts": {
    "dev": "DEBUG=boundary:* electron-forge start",
    "dev:product": "DEBUG=boundary:* electron-forge start",
    "dev:local-stack": "./scripts/dev-local-stack.sh",
    "dev:fresh": "./scripts/reset-boundary-dev-state.sh --yes && BOUNDARY_EMULATE_NO_DOCKER=1 DEBUG=boundary:* electron-forge start",
    "reset:dev-state": "./scripts/reset-boundary-dev-state.sh",
    "build": "electron-forge package",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "dist": "electron-forge make",
    "rebuild:macos-alias": "npm rebuild macos-alias",
    "dist:mac": "npm run fetch:container-runtime && npm run rebuild:macos-alias && electron-forge make --platform=darwin",
    "dist:win": "electron-forge make --platform=win32",
    "dist:linux": "electron-forge make --platform=linux",
    "publish": "electron-forge publish",
    "type-check": "tsc --noEmit",
    "lint": "eslint --ext .ts,.tsx .",
    "test": "vitest run",
    "test:main-services": "vitest run --config src/main/vitest.main-services.config.ts",
    "test:renderer-unit": "vitest run --config src/renderer/vitest.renderer-unit.config.ts",
    "fetch:container-runtime": "./scripts/fetch-container-runtime.sh",
    "notices": "node scripts/generate-third-party-notices.mjs",
    "smoke:bundled-podman": "./scripts/smoke-bundled-podman.sh",
    "test:inference": "vitest run --config src/main/vitest.main-services.config.ts",
    "test:inference:live": "vitest run --config src/main/vitest.main-services.config.ts src/main/services/__tests__/inference-deployment.live.test.ts",
    "test:hermes:live": "vitest run --config src/main/vitest.main-services.config.ts src/main/services/assistant/hermes/__tests__/hermesHistoryBudget.live.test.ts",
    "db:generate": "cd src/main/db && drizzle-kit generate",
    "db:migrate": "cd src/main/db && drizzle-kit migrate",
    "db:studio": "cd src/main/db && drizzle-kit studio",
    "rebuild:drizzle": "node-gyp rebuild --directory=./node_modules/better-sqlite3",
    "rebuild:electron": "electron-builder install-app-deps",
    "rebuild:better-sqlite3": "electron-rebuild -f -w better-sqlite3",
    "enode": "ELECTRON_RUN_AS_NODE=1 electron",
    "etsx": "pnpm enode ./node_modules/tsx/dist/cli.cjs"
  },
  "keywords": [],
  "author": {
    "name": "Keith Axline",
    "email": "keith@yachtcopter.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.9.0",
    "@electron-forge/maker-deb": "^7.9.0",
    "@electron-forge/maker-dmg": "^7.9.0",
    "@electron-forge/maker-rpm": "^7.9.0",
    "@electron-forge/maker-squirrel": "^7.9.0",
    "@electron-forge/maker-zip": "^7.9.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.9.0",
    "@electron-forge/plugin-fuses": "^7.9.0",
    "@electron-forge/plugin-vite": "^7.9.0",
    "@electron/fuses": "^1.8.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.19",
    "@types/better-sqlite3": "^7.6.13",
    "@types/dockerode": "^3.3.44",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^5.0.3",
    "electron": "35.0.2",
    "electron-rebuild": "^3.2.9",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.31.0",
    "jsdom": "^27.0.1",
    "tailwindcss": "^4.1.13",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.17",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/vite": "^4.1.13",
    "@tanstack/react-query": "^5.90.2",
    "@testing-library/react": "^16.3.0",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/js-yaml": "^4.0.9",
    "@xstate/graph": "^3.0.4",
    "better-sqlite3": "^12.4.1",
    "bufferutil": "^4.0.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "debug": "^4.4.3",
    "dockerode": "^4.0.8",
    "drizzle-kit": "^0.31.4",
    "drizzle-orm": "^0.44.5",
    "electron-builder": "^26.0.12",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^10.1.0",
    "git": "^0.1.5",
    "js-yaml": "^4.1.0",
    "lucide-react": "^0.544.0",
    "next-themes": "^0.4.6",
    "node-abi": "^4.14.0",
    "playwright": "^1.56.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.0.48",
    "utf-8-validate": "^6.0.5",
    "ws": "^8.18.3",
    "zod": "^4.1.11"
  }
}
