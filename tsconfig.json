{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "allowJs": true,
    "jsx": "preserve",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "baseUrl": ".",
    "outDir": "dist",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./src/renderer/*"]
    }
  },
  "include": [
    "src/main/**/*",
    "src/renderer/**/*",
    "src/shared/**/*",
    "src/preload.ts",
    "forge.env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "out",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/vitest.*.ts",
    "**/*.config.ts"
  ]
}
