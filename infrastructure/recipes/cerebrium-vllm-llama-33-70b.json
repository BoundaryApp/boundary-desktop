{
  "id": "cerebrium-vllm-llama-33-70b",
  "modelId": "meta-llama/Llama-3.3-70B-Instruct",
  "provider": "cerebrium",
  "displayName": "Cerebrium vLLM (Llama 3.3 70B)",
  "description": "Deploy Llama 3.3 70B on Cerebrium with vLLM. Requires Cerebrium service account token, project ID, and Hugging Face access to the gated model.",
  "driver": {
    "kind": "cerebrium-api",
    "config": {
      "app_name": "boundary-llama-33-70b",
      "served_model_name": "meta-llama/Llama-3.3-70B-Instruct",
      "compute": "HOPPER_H100",
      "gpu_count": 2,
      "cpu": 16,
      "memory": 160,
      "region": "aws.us-east-1",
      "port": 8000,
      "max_model_len": 8192,
      "gpu_memory_utilization": 0.9,
      "tensor_parallel_size": 2,
      "hf_secret_name": "HF_TOKEN"
    }
  },
  "secrets": [
    {
      "name": "cerebrium_service_account_token",
      "type": "string",
      "description": "Cerebrium service account token from the Cerebrium dashboard API Keys page",
      "required": true,
      "sensitive": true,
      "group": "Credentials"
    },
    {
      "name": "cerebrium_project_id",
      "type": "string",
      "description": "Cerebrium project ID, for example p-xxxxxxxx",
      "required": true,
      "sensitive": false,
      "group": "Credentials"
    },
    {
      "name": "hf_token",
      "type": "string",
      "description": "Hugging Face access token with access to meta-llama/Llama-3.3-70B-Instruct",
      "required": true,
      "sensitive": true,
      "group": "Credentials"
    }
  ],
  "readiness": {
    "probe": "openai-models",
    "warmupPost": true,
    "verifyChatCompletion": true,
    "warmingTimeoutMs": 2700000,
    "pollIntervalMs": {
      "warming": 30000,
      "active": 45000,
      "degraded": 120000
    }
  },
  "outputs": {
    "authSecret": "cerebrium_inference_api_key",
    "openaiBaseUrlKey": "openai_base_url"
  }
}
