{
  "id": "cerebrium-vllm-gemma4-27b-it",
  "modelId": "google/gemma-4-27b-it",
  "provider": "cerebrium",
  "displayName": "Cerebrium vLLM (Gemma 4 27B IT)",
  "description": "Deploy Gemma 4 27B IT on Cerebrium with vLLM using an A100 80GB GPU.",
  "driver": {
    "kind": "cerebrium-api",
    "config": {
      "app_name": "boundary-gemma4-27b-it",
      "served_model_name": "google/gemma-4-27b-it",
      "compute": "AMPERE_A100_80GB",
      "gpu_count": 1,
      "cpu": 8,
      "memory": 96,
      "region": "aws.us-east-1",
      "port": 8000,
      "max_model_len": 8192,
      "gpu_memory_utilization": 0.9,
      "hf_secret_name": "HF_TOKEN"
    }
  },
  "secrets": [
    {
      "name": "cerebrium_service_account_token",
      "type": "string",
      "description": "Cerebrium service account token from the Cerebrium dashboard API Keys page",
      "required": true,
      "sensitive": true,
      "group": "Credentials"
    },
    {
      "name": "cerebrium_project_id",
      "type": "string",
      "description": "Cerebrium project ID, for example p-xxxxxxxx",
      "required": true,
      "sensitive": false,
      "group": "Credentials"
    },
    {
      "name": "hf_token",
      "type": "string",
      "description": "Hugging Face access token with access to the gated Gemma model",
      "required": true,
      "sensitive": true,
      "group": "Credentials"
    }
  ],
  "readiness": {
    "probe": "openai-models",
    "warmupPost": true,
    "verifyChatCompletion": true,
    "warmingTimeoutMs": 2700000,
    "pollIntervalMs": {
      "warming": 30000,
      "active": 45000,
      "degraded": 120000
    }
  },
  "outputs": {
    "authSecret": "cerebrium_inference_api_key",
    "openaiBaseUrlKey": "openai_base_url"
  }
}
