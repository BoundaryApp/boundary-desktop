{
  "id": "runpod-vllm-llama",
  "modelId": "meta-llama/Llama-3.3-70B-Instruct",
  "provider": "runpod",
  "displayName": "RunPod vLLM (Llama 3.3)",
  "description": "Serverless vLLM endpoint on RunPod with OpenAI-compatible API. Requires RunPod API key and Hugging Face token.",
  "legacyStackTypeId": "runpod-vllm-llama",
  "terraformMinVersion": "1.5.0",
  "modulePath": "modules/runpod-vllm-llama",
  "profilePath": "profiles/runpod-vllm-llama.json",
  "driver": {
    "kind": "terraform",
    "artifactPath": "modules/runpod-vllm-llama",
    "config": {
      "dockerImage": "runpod/worker-v1-vllm:v2.18.1",
      "template": {
        "containerDiskInGb": 200,
        "category": "NVIDIA"
      },
      "templateEnv": {
        "MODEL_NAME": "meta-llama/Llama-3.3-70B-Instruct",
        "MAX_MODEL_LEN": "8192",
        "TENSOR_PARALLEL_SIZE": "2",
        "GPU_MEMORY_UTILIZATION": "0.90"
      },
      "terraform": {
        "endpoint_name": "boundary-llama-vllm",
        "data_center_ids": "US-CA-2, US-TX-3",
        "gpu_type_ids": "NVIDIA A100 80GB PCIe, NVIDIA A100-SXM4-80GB",
        "gpu_count": 2,
        "workers_max": 3,
        "idle_timeout": 60,
        "flashboot": true
      }
    }
  },
  "secrets": [
    {
      "name": "runpod_api_key",
      "type": "string",
      "description": "RunPod API key from https://www.runpod.io/console/user/settings",
      "required": true,
      "sensitive": true,
      "group": "Credentials"
    },
    {
      "name": "hf_token",
      "type": "string",
      "description": "Hugging Face access token with access to meta-llama/Llama-3.3-70B-Instruct",
      "required": true,
      "sensitive": true,
      "group": "Credentials"
    }
  ],
  "readiness": {
    "probe": "openai-models",
    "warmupPost": true,
    "warmingTimeoutMs": 2700000,
    "pollIntervalMs": {
      "warming": 60000,
      "active": 45000,
      "degraded": 120000
    }
  },
  "outputs": {
    "authSecret": "runpod_api_key",
    "openaiBaseUrlKey": "openai_base_url"
  }
}
