{
  "id": "baseten-llama-33-70b",
  "modelId": "meta-llama/Llama-3.3-70B-Instruct",
  "provider": "baseten",
  "displayName": "Baseten vLLM (Llama 3.3 70B)",
  "description": "Deploy Llama 3.3 70B on Baseten via Truss + vLLM. Requires Baseten API key and Hugging Face token (gated model). Boundary installs Truss on first deploy. First deploy may take 30–45+ minutes.",
  "driver": {
    "kind": "baseten-truss",
    "artifactPath": "baseten-truss/llama-3.3-70b-instruct",
    "config": {
      "served_model_name": "meta-llama/Llama-3.3-70B-Instruct",
      "hf_repo": "meta-llama/Llama-3.3-70B-Instruct",
      "hf_secret_name": "hf_access_token"
    }
  },
  "secrets": [
    {
      "name": "baseten_api_key",
      "type": "string",
      "description": "Baseten API key from https://app.baseten.co/settings/api-keys",
      "required": true,
      "sensitive": true,
      "group": "Credentials"
    },
    {
      "name": "hf_token",
      "type": "string",
      "description": "Hugging Face access token with access to meta-llama/Llama-3.3-70B-Instruct (accept the model license on huggingface.co first)",
      "required": true,
      "sensitive": true,
      "group": "Credentials"
    }
  ],
  "readiness": {
    "probe": "openai-models",
    "warmupPost": true,
    "verifyChatCompletion": true,
    "warmingTimeoutMs": 2700000,
    "pollIntervalMs": {
      "warming": 30000,
      "active": 45000,
      "degraded": 120000
    }
  },
  "outputs": {
    "authSecret": "baseten_api_key",
    "openaiBaseUrlKey": "openai_base_url"
  }
}
