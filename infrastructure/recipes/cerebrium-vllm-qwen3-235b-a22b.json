{
  "id": "cerebrium-vllm-qwen3-235b-a22b",
  "modelId": "Qwen/Qwen3-235B-A22B",
  "provider": "cerebrium",
  "displayName": "Cerebrium vLLM (Qwen 3 235B A22B)",
  "description": "Deploy the large Qwen 3 MoE model on Cerebrium with vLLM and four H100 GPUs.",
  "driver": {
    "kind": "cerebrium-api",
    "config": {
      "app_name": "boundary-qwen3-235b-a22b",
      "served_model_name": "Qwen/Qwen3-235B-A22B",
      "compute": "HOPPER_H100",
      "gpu_count": 4,
      "cpu": 32,
      "memory": 320,
      "region": "aws.us-east-1",
      "port": 8000,
      "max_model_len": 32768,
      "gpu_memory_utilization": 0.9,
      "tensor_parallel_size": 4,
      "hf_secret_name": "HF_TOKEN"
    }
  },
  "secrets": [
    {
      "name": "cerebrium_service_account_token",
      "type": "string",
      "description": "Cerebrium service account token from the Cerebrium dashboard API Keys page",
      "required": true,
      "sensitive": true,
      "group": "Credentials"
    },
    {
      "name": "cerebrium_project_id",
      "type": "string",
      "description": "Cerebrium project ID, for example p-xxxxxxxx",
      "required": true,
      "sensitive": false,
      "group": "Credentials"
    },
    {
      "name": "hf_token",
      "type": "string",
      "description": "Optional Hugging Face token for higher Hub rate limits or private mirrors",
      "required": false,
      "sensitive": true,
      "group": "Credentials"
    }
  ],
  "readiness": {
    "probe": "openai-models",
    "warmupPost": true,
    "verifyChatCompletion": true,
    "warmingTimeoutMs": 3600000,
    "pollIntervalMs": {
      "warming": 45000,
      "active": 60000,
      "degraded": 120000
    }
  },
  "outputs": {
    "authSecret": "cerebrium_inference_api_key",
    "openaiBaseUrlKey": "openai_base_url"
  }
}
