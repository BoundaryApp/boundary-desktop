{
  "id": "runpod-vllm-llama",
  "dockerImage": "runpod/worker-v1-vllm:v2.18.1",
  "template": {
    "containerDiskInGb": 200,
    "category": "NVIDIA"
  },
  "templateEnv": {
    "MODEL_NAME": "meta-llama/Llama-3.3-70B-Instruct",
    "MAX_MODEL_LEN": "8192",
    "TENSOR_PARALLEL_SIZE": "2",
    "GPU_MEMORY_UTILIZATION": "0.90"
  },
  "terraform": {
    "endpoint_name": "boundary-llama-vllm",
    "data_center_ids": "US-CA-2, US-TX-3",
    "gpu_type_ids": "NVIDIA A100 80GB PCIe, NVIDIA A100-SXM4-80GB",
    "gpu_count": 2,
    "workers_max": 3,
    "idle_timeout": 60,
    "flashboot": true
  }
}
